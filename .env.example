# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — do not commit secrets.
#
# Currently the enquiry form is mailto-based and does not need any of
# these. They are required only if you wire up a real form backend
# (e.g. Resend via a Vercel Function at api/enquire.js).

# Resend — https://resend.com
RESEND_API_KEY=

# Where the gallery receives enquiries
ENQUIRY_TO_EMAIL=enquiries@monolith.gallery

# What appears in the From line of outgoing email.
# Use onboarding@resend.dev for the Resend sandbox until your domain
# is verified, otherwise use a verified address on your domain.
ENQUIRY_FROM_EMAIL=Monolith <enquiries@monolith.gallery>
