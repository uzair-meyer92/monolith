# Copy this file to .env.local for local dev, and set the same values
# in Vercel → Project → Settings → Environment Variables for production.
# .env.local is gitignored — do not commit secrets.
#
# Form IDs are not secret (anyone can read them from the rendered HTML),
# but using env vars keeps the source clean and lets prod/preview/dev
# point at different inboxes.

# Formspree — https://formspree.io
# After signing up, create two forms and paste their IDs here. The ID
# is the 8-character string at the end of the form's action URL,
# e.g. https://formspree.io/f/xpzgkqab → "xpzgkqab".
#
# Vite exposes any var prefixed VITE_ to the client at build time.
VITE_FORMSPREE_ENQUIRY=
VITE_FORMSPREE_NEWSLETTER=
